# Run configure.py to create .env and generate NOTIFY_SECRET locally.
# No quotes or inline comments in values. Do not commit .env or credentials.
# Filled by pair_bot.py after receiving the exact private-message challenge:
QQ_APPID=
QQ_SECRET=
QQ_OPENID=
QQ_SANDBOX=0
QQ_BOUND_APPID=
QQ_BOUND_SANDBOX=

# Keep local-only. Use a different port if already occupied.
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=8787
# Generated by configure.py; copy this value locally into Hermes HERMES_NOTIFY_SECRET.
NOTIFY_SECRET=
NOTIFY_FORMAT=image
SUMMARY_CHARS=1400
ONLY_TOOL_TURNS=1
NOTIFY_SESSION_END=0

# Empty: HERMES_HOME process override, then LOCALAPPDATA/hermes, then ~/.hermes.
# Set an absolute path for a custom Hermes installation/profile.
HERMES_HOME=
